@page "/events"
@using EventEaseApp.Components
@using EventEaseApp.Models
@using EventEaseApp.Services
@inject EventService EventService

<PageTitle>Events</PageTitle>

<h1 class="events-title">Upcoming Events in Denmark</h1>

<p class="events-subtitle">Celebrations, concerts and custom events happening across Denmark.</p>

@if (events is null)
{
    <p><em>Loading...</em></p>
}
else if (events.Count == 0)
{
    <p>No events are currently scheduled.</p>
}
else
{
    <div class="event-list">
        <Virtualize Items="events" Context="ev" ItemSize="200" OverscanCount="4">
            <div class="event-list-item" @key="ev.Id">
                <EventCard Event="ev" />
            </div>
        </Virtualize>
    </div>
}

@code {
    private List<Models.Event>? events;

    protected override void OnInitialized()
    {
        events = EventService.GetEvents();
    }
}
